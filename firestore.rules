rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function price(p) {
      return p is map && p.keys().hasOnly(['packCents', 'quantity'])
        && p.packCents is int && p.packCents >= 0 && p.packCents <= 10000000
        && p.quantity is int && p.quantity > 0 && p.quantity <= 1000;
    }
    function category(c) {
      return c is map && c.keys().hasOnly(['dailyCountMilli', 'price'])
        && c.dailyCountMilli is int && c.dailyCountMilli >= 0 && c.dailyCountMilli <= 1000000 && price(c.price);
    }
    function categories(c) {
      return c is map && c.keys().hasOnly(['pouch', 'cigarette', 'cigar']) && c.size() > 0
        && (!('pouch' in c) || category(c.pouch))
        && (!('cigarette' in c) || category(c.cigarette))
        && (!('cigar' in c) || category(c.cigar));
    }
    function date(d) { return d is string && d.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function cigarPrice(c) { return c is int && c >= 0 && c <= 10000000; }
    function cigarPresets(p) { return p is list && p.size() == 3 && cigarPrice(p[0]) && cigarPrice(p[1]) && cigarPrice(p[2]); }
    function rewardEvidence(e) {
      return e is map && e.keys().hasOnly(['startDate', 'endDate', 'startEntryId', 'startMs', 'targetMinutes', 'awakeMinutes', 'intervalMinutes', 'detail'])
        && date(e.startDate) && date(e.endDate) && e.startEntryId is string && e.startMs is number && e.startMs >= 0
        && e.targetMinutes is number && e.targetMinutes >= 0 && e.awakeMinutes is number && e.awakeMinutes >= 0 && e.intervalMinutes is number && e.intervalMinutes >= 0 && e.detail is string;
    }
    function award(a, id, achievement) {
      return a.keys().hasOnly(['id', 'type', 'name', 'milestone', 'earnedAt', 'date', 'xp', 'status', 'evidence', 'revision', 'firstRecordedAt', 'updatedAt', 'reason'])
        && a.id == id && a.name is string && a.milestone is string && date(a.date)
        && a.earnedAt is number && a.earnedAt >= 0 && a.firstRecordedAt is number && a.updatedAt is number && a.reason is string
        && a.status in ['valid', 'provisional', 'invalidated'] && a.revision is int && a.revision > 0
        && a.xp is int && a.xp >= 0 && a.xp <= 200 && rewardEvidence(a.evidence)
        && (achievement ? (a.type == 'achievement' && a.xp == 0) : a.type in ['spacing', 'abstinence']);
    }
    match /users/{uid} {
      allow read, write: if owner(uid);
      // Do not let a broad recursive write rule bypass financial-document validation.
      match /{section}/{document=**} {
        allow read: if owner(uid);
        allow write: if owner(uid) && !(section in ['settings', 'baselines', 'coverage', 'rewards', 'achievements']);
      }
      match /settings/{setting} {
        allow write: if owner(uid) && !(setting in ['pricing', 'baselineState', 'sleep', 'rewardState']);
      }
      match /settings/rewardState {
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['sourceRevision', 'processedRevision', 'evaluatedRevision', 'evaluatedAt'])
          && request.resource.data.sourceRevision is int && request.resource.data.sourceRevision >= 0
          && (!exists(/databases/$(database)/documents/users/$(uid)/settings/rewardState)
            || (request.resource.data.sourceRevision >= resource.data.sourceRevision && request.resource.data.sourceRevision <= resource.data.sourceRevision + 1))
          && (!('processedRevision' in request.resource.data) || (request.resource.data.processedRevision is int && request.resource.data.processedRevision >= 0 && request.resource.data.processedRevision <= request.resource.data.sourceRevision))
          && (!('evaluatedRevision' in request.resource.data) || (request.resource.data.evaluatedRevision is int && request.resource.data.evaluatedRevision >= 0 && request.resource.data.evaluatedRevision <= request.resource.data.sourceRevision))
          && (!('evaluatedAt' in request.resource.data) || (request.resource.data.evaluatedAt is number && request.resource.data.evaluatedAt >= 0));
        allow delete: if false;
      }
      match /{ledger}/{awardId} {
        allow create, update: if ledger in ['rewards', 'achievements'] && owner(uid)
          && award(request.resource.data, awardId, ledger == 'achievements')
          && ((!exists(/databases/$(database)/documents/users/$(uid)/$(ledger)/$(awardId)) && request.resource.data.revision == 1)
            || (request.resource.data.revision == resource.data.revision + 1 && request.resource.data.firstRecordedAt == resource.data.firstRecordedAt))
          && getAfter(/databases/$(database)/documents/users/$(uid)/$(ledger)/$(awardId)/history/$(string(request.resource.data.revision))).data.status == request.resource.data.status;
        match /history/{version} {
          allow create: if ledger in ['rewards', 'achievements'] && owner(uid)
            && request.resource.data.keys().hasOnly(['version', 'sourceRevision', 'previousStatus', 'status', 'previousXp', 'xp', 'at', 'reason', 'evidence'])
            && request.resource.data.version is int && string(request.resource.data.version) == version
            && request.resource.data.sourceRevision is int && request.resource.data.sourceRevision >= 0
            && request.resource.data.previousStatus in ['none', 'valid', 'provisional', 'invalidated']
            && request.resource.data.status in ['valid', 'provisional', 'invalidated'] && request.resource.data.at is number
            && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 200
            && request.resource.data.previousXp is int && request.resource.data.previousXp >= 0 && request.resource.data.previousXp <= 200
            && request.resource.data.reason is string && rewardEvidence(request.resource.data.evidence)
            && getAfter(/databases/$(database)/documents/users/$(uid)/$(ledger)/$(awardId)).data.revision == request.resource.data.version
            && getAfter(/databases/$(database)/documents/users/$(uid)/$(ledger)/$(awardId)).data.xp == request.resource.data.xp;
          allow update, delete: if false;
        }
      }
      match /settings/sleep {
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['start', 'end'])
          && request.resource.data.start is string && request.resource.data.end is string
          && request.resource.data.start.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.end.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
          && request.resource.data.start != request.resource.data.end;
        allow delete: if owner(uid);
      }
      match /settings/pricing {
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['pouch', 'cigarette', 'cigarPresetsCents'])
          && (!('cigarPresetsCents' in request.resource.data) || cigarPresets(request.resource.data.cigarPresetsCents))
          && (request.resource.data.pouch == null || price(request.resource.data.pouch))
          && (request.resource.data.cigarette == null || price(request.resource.data.cigarette));
        allow delete: if owner(uid);
      }
      match /settings/baselineState {
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['lastEffectiveOn'])
          && date(request.resource.data.lastEffectiveOn)
          && (!exists(/databases/$(database)/documents/users/$(uid)/settings/baselineState)
              || request.resource.data.lastEffectiveOn > resource.data.lastEffectiveOn)
          && getAfter(/databases/$(database)/documents/users/$(uid)/baselines/$(request.resource.data.lastEffectiveOn)).data.createdAt == request.time;
      }
      match /baselines/{version} {
        allow create: if owner(uid) && request.resource.data.keys().hasOnly(['id', 'effectiveOn', 'createdAt', 'categories'])
          && request.resource.data.id == version && request.resource.data.effectiveOn == version && date(version)
          && request.resource.data.createdAt == request.time && categories(request.resource.data.categories)
          && (!exists(/databases/$(database)/documents/users/$(uid)/settings/baselineState)
              || version > get(/databases/$(database)/documents/users/$(uid)/settings/baselineState).data.lastEffectiveOn)
          && getAfter(/databases/$(database)/documents/users/$(uid)/settings/baselineState).data.lastEffectiveOn == version;
        // Immutable versions: later changes append a new effective date.
        allow update, delete: if false;
      }
      match /coverage/{day} {
        allow create, update: if owner(uid) && request.resource.data.keys().hasOnly(['date', 'complete', 'updatedAt'])
          && date(day) && request.resource.data.date == day && request.resource.data.complete is bool
          && request.resource.data.updatedAt == request.time;
        allow delete: if owner(uid);
      }
    }
  }
}
